@model KLS.Models.EmailReceipt
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var payment = Model.Payment;
    var payee = Model.Payee;
    var paymentDetails = payment?.PaymentDetails;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Receipt</title>
    <partial name="_EmailTheme" />
    <style>
        .summary-value { font-size: 32px; line-height: 1.1; }

        .summary-note {
            margin-top: 8px;
            color: #6b6680;
            font-size: 13px;
        }

        .payment-meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        .payment-meta-table td {
            border: none;
            vertical-align: top;
            padding: 0;
        }

        .meta-cell-right { padding-left: 8px !important; }
        .meta-cell-left { padding-right: 8px !important; }
        .meta-cell-center { padding-left: 4px !important; padding-right: 4px !important; }

        .meta-card {
            padding: 18px 20px;
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #f7f5ff 100%);
            border: 1px solid #e0daf0;
            box-shadow: 0 4px 14px rgba(87, 90, 255, 0.04);
        }

        .meta-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6b6680;
            margin-bottom: 8px;
        }

        .meta-value {
            font-size: 16px;
            font-weight: 700;
            color: #2d2844;
            line-height: 1.5;
            word-break: break-word;
        }

        .amount-card {
            background: linear-gradient(180deg, #f5f3ff 0%, #ede9fe 100%);
            border: 1px solid #d6cef0;
        }

        .meta-value.amount {
            color: #5b21b6;
            font-size: 22px;
            font-weight: 900;
        }

        .table-wrap thead th { padding: 10px 10px; }
        .table-wrap tbody td { padding: 8px 10px; }

        .invoice-no {
            font-weight: 800;
            color: #5b21b6;
            letter-spacing: 0.2px;
        }

        .invoice-date {
            color: #5b527a;
            font-weight: 600;
        }

        .discount {
            color: #8b6a17;
            font-weight: 700;
            white-space: nowrap;
        }

        .payment-applied {
            color: #2d2844;
            font-weight: 800;
            white-space: nowrap;
        }

        .total-value { font-size: 24px; }

        @@media only screen and (max-width: 768px) {
            .summary-value { font-size: 26px; }

            .payment-meta-table,
            .payment-meta-table tbody,
            .payment-meta-table tr,
            .payment-meta-table td {
                display: block !important;
                width: 100% !important;
            }

            .title-block {
                padding-right: 0;
                padding-bottom: 16px;
            }

            .meta-cell-left,
            .meta-cell-right,
            .meta-cell-center {
                padding: 0 0 12px 0 !important;
            }

            .table-wrap thead th,
            .table-wrap tbody td,
            .table-wrap tfoot td {
                padding: 12px 10px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="mail-card">
            <div class="top-accent"></div>

            <div class="header">
               @*  <div class="logo-section">
                    <partial name="_Header.cshtml" model="@Model.Company" />
                </div> *@

                <table class="header-table" role="presentation">
                    <tr>
                        <td style="width:65%;">
                            <div class="title-block">
                                <div class="eyebrow">Payment Confirmation</div>
                                <h1 class="title">Payment Receipt</h1>
                                <p class="subtitle">
                                    A premium confirmation of your recent payment and its applied invoice details.
                                </p>
                            </div>
                        </td>
                        <td style="width:35%;">
                            <div class="summary-box">
                                <div class="summary-label">Amount Received</div>
                                <p class="summary-value">
                                    @string.Format("{0:c}", payment?.PaymentAmount)
                                </p>
                               @*  <div class="summary-note">
                                    Thank you for your payment. Your receipt details are listed below.
                                </div> *@
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="content">
                <div class="greeting-box">
                    <p class="customer">Dear @(payee?.PayeeName ?? ""),</p>
                    <p class="greeting-text">
                        Thank you for your recent payment of
                        <strong>@string.Format("{0:c}", payment?.PaymentAmount)</strong>.
                        Please find below the payment information and the invoices to which your payment has been applied.
                    </p>
                </div>

                <table class="payment-meta-table" role="presentation">
                    <tr>
                        <td style="width:33.33%;" class="meta-cell-left">
                            <div class="meta-card">
                                <div class="meta-label">Payment Type</div>
                                <div class="meta-value">@payment?.PaymentMethod</div>
                            </div>
                        </td>
                        <td style="width:33.33%;" class="meta-cell-center">
                            <div class="meta-card">
                                <div class="meta-label">Payment Number</div>
                                <div class="meta-value">@payment?.PaymentNumber</div>
                            </div>
                        </td>
                        <td style="width:33.33%;" class="meta-cell-right">
                            <div class="meta-card">
                                <div class="meta-label">Payment Date</div>
                                <div class="meta-value">
                                    @(payment?.PaymentDate.HasValue == true ? payment.PaymentDate.Value.ToString("D") : "")
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="width:100%; padding-top:15px;">
                            <div class="meta-card">
                                <div class="meta-label">Reference Number</div>
                                <div class="meta-value">@payment?.ReferenceId</div>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 24%;">Invoice #</th>
                                <th style="width: 26%;">Invoice Date</th>
                                <th style="width: 20%; text-align:right;">Discount</th>
                                <th style="width: 30%; text-align:right;">Amount Applied</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (paymentDetails != null && paymentDetails.Any())
                            {
                                foreach (var item in paymentDetails)
                                {
                                    <tr>
                                        <td class="invoice-no">@item.Sales?.SalesNumber</td>
                                        <td class="invoice-date">
                                            @if (item.Sales != null)
                                            {
                                                @string.Format("{0:MMM dd yyyy}", item.Sales.ShipDate)
                                            }
                                        </td>
                                        <td class="discount" style="text-align:right;">
                                            @string.Format("{0:c}", item.DiscountApplied)
                                        </td>
                                        <td class="payment-applied" style="text-align:right;">
                                            @string.Format("{0:c}", item.PaymentApplied)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; padding:30px; color:#6b6680;">
                                        No payment application details available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="total-label">Total Payment</td>
                                <td class="total-value" style="text-align:right;">
                                    @string.Format("{0:c}", payment?.PaymentAmount)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="footer">
                    <p>
                        If you have any questions regarding this payment receipt, please do not hesitate to contact us. We are always happy to assist you.
                    </p>
                    <p>
                        Thank you again for your business and for the opportunity to serve you.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
