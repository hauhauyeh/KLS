@model KLS.Models.EmailReceipt
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Receipt</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at top left, #f8fcef 0%, #edf7df 40%, #e4f0d0 100%);
            color: #24311d;
        }

        .page-wrap {
            max-width: 980px;
            margin: 0 auto;
        }

        .receipt-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfdf8 100%);
            border: 1px solid #dfe9cd;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 18px 44px rgba(48, 74, 18, 0.10), 0 4px 14px rgba(48, 74, 18, 0.06);
        }

        .top-accent {
            height: 8px;
            background: linear-gradient(90deg, #6f9f10 0%, #8fbe22 45%, #c7e57d 100%);
        }

        .header {
            padding: 36px 42px 28px;
            border-bottom: 1px solid #edf3e1;
            background: linear-gradient(135deg, rgba(143, 190, 34, 0.10), rgba(255,255,255,0) 45%);
        }

        .logo-section {
            margin-bottom: 20px;
            padding-bottom: 18px;
            border-bottom: 1px solid #e9f0dd;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

            .header-table td {
                vertical-align: top;
                border: none;
                padding: 0;
            }

        .title-block {
            padding-right: 20px;
        }

        .eyebrow {
            display: inline-block;
            margin-bottom: 14px;
            padding: 7px 14px;
            border-radius: 999px;
            background: #eef7da;
            color: #5d8210;
            border: 1px solid #dce8c8;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.15px;
            text-transform: uppercase;
        }

        .title {
            margin: 0;
            font-size: 30px;
            line-height: 1.1;
            font-weight: 800;
            color: #1f2b19;
        }

        .subtitle {
            margin: 10px 0 0;
            color: #66735c;
            font-size: 15px;
            line-height: 1.6;
        }

        .paid-box {
            padding: 20px 24px;
            border-radius: 20px;
            border: 1px solid #dce8c8;
            background: linear-gradient(180deg, #f8fcef 0%, #eff6e2 100%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.75);
        }

        .paid-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6b785f;
            margin-bottom: 8px;
        }

        .paid-value {
            margin: 0;
            font-size: 32px;
            font-weight: 900;
            color: #256328;
            line-height: 1.1;
        }

        .paid-note {
            margin-top: 8px;
            color: #66735c;
            font-size: 13px;
        }

        .content {
            padding: 34px 42px 40px;
        }

        .greeting-box {
            margin-bottom: 28px;
            padding: 22px 24px;
            border-radius: 18px;
            background: #fcfef8;
            border: 1px solid #e8efdb;
            border-left: 5px solid #8fbe22;
        }

        .customer {
            margin: 0 0 8px 0;
            font-size: 21px;
            font-weight: 800;
            color: #293521;
        }

        .greeting-text {
            margin: 0;
            color: #5f6c56;
            font-size: 15px;
            line-height: 1.75;
        }

        .payment-meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

            .payment-meta-table td {
                border: none;
                vertical-align: top;
                padding: 0;
            }

        .meta-cell-right {
            padding-left: 8px !important;
        }

        .meta-cell-left {
            padding-right: 8px !important;
        }

        .meta-cell-center {
            padding-left: 4px !important;
            padding-right: 4px !important;
        }

        .meta-card {
            padding: 18px 20px;
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #fafdf5 100%);
            border: 1px solid #e5edd7;
            box-shadow: 0 4px 14px rgba(36, 49, 29, 0.04);
        }

        .meta-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6c7a61;
            margin-bottom: 8px;
        }

        .meta-value {
            font-size: 16px;
            font-weight: 700;
            color: #2c3826;
            line-height: 1.5;
            word-break: break-word;
        }

        .amount-card {
            background: linear-gradient(180deg, #f8fcef 0%, #eff6e2 100%);
            border: 1px solid #dce8c8;
        }

        .meta-value.amount {
            color: #256328;
            font-size: 22px;
            font-weight: 900;
        }

        .table-wrap {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid #e5edd7;
            background: #ffffff;
            box-shadow: 0 6px 18px rgba(36, 49, 29, 0.04);
        }

        table.receipt-lines {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        .receipt-lines thead th {
            padding: 16px 18px;
            text-align: left;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.4px;
            color: #ffffff;
            background: linear-gradient(90deg, #6f9f10 0%, #87b91a 100%);
            border: none;
        }

        .receipt-lines tbody td {
            padding: 15px 18px;
            border-bottom: 1px solid #eef3e5;
            font-size: 14px;
            color: #33412c;
            vertical-align: middle;
        }

        .receipt-lines tbody tr:nth-child(even) td {
            background-color: #fbfdf8;
        }

        .receipt-lines tbody tr:last-child td {
            border-bottom: none;
        }

        .invoice-no {
            font-weight: 800;
            color: #4f641f;
            letter-spacing: 0.2px;
        }

        .invoice-date {
            color: #55644c;
            font-weight: 600;
        }

        .discount {
            color: #8b6a17;
            font-weight: 700;
            white-space: nowrap;
        }

        .payment-applied {
            color: #27341f;
            font-weight: 800;
            white-space: nowrap;
        }

        .receipt-lines tfoot td {
            padding: 18px;
            background: #fafdf5;
            border-top: 2px solid #dce8c8;
        }

        .total-label {
            text-align: right;
            font-size: 16px;
            font-weight: 900;
            color: #34422d;
        }

        .total-value {
            font-size: 24px;
            font-weight: 900;
            color: #256328;
            white-space: nowrap;
        }

        .footer {
            margin-top: 28px;
            padding: 22px 24px;
            border-radius: 18px;
            border: 1px solid #e7efda;
            background: linear-gradient(180deg, #fcfef8 0%, #f6faef 100%);
        }

            .footer p {
                margin: 0 0 10px 0;
                color: #5d6a54;
                font-size: 14px;
                line-height: 1.75;
            }

                .footer p:last-child {
                    margin-bottom: 0;
                }

        .signature {
            margin-top: 14px;
            font-weight: 800;
            color: #314028;
        }

        @@media print {
            body {
                padding: 0;
                background: #ffffff;
            }

            .receipt-card {
                box-shadow: none;
                border: 1px solid #d9d9d9;
            }
        }

        @@media only screen and (max-width: 768px) {
            .header,
            .content {
                padding: 24px;
            }

            .title {
                font-size: 28px;
            }

            .paid-value {
                font-size: 26px;
            }

            .header-table,
            .header-table tbody,
            .header-table tr,
            .header-table td,
            .payment-meta-table,
            .payment-meta-table tbody,
            .payment-meta-table tr,
            .payment-meta-table td {
                display: block !important;
                width: 100% !important;
            }

            .title-block {
                padding-right: 0;
                padding-bottom: 16px;
            }

            .meta-cell-left,
            .meta-cell-right,
            .meta-cell-center {
                padding: 0 0 12px 0 !important;
            }

            .receipt-lines thead th,
            .receipt-lines tbody td,
            .receipt-lines tfoot td {
                padding: 12px 10px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="receipt-card">
            <div class="top-accent"></div>

            <div class="header">
               @*  <div class="logo-section">
                    <partial name="_Header.cshtml" model="@Model.Company" />
                </div> *@

                <table class="header-table" role="presentation">
                    <tr>
                        <td style="width:65%;">
                            <div class="title-block">
                                <div class="eyebrow">Payment Confirmation</div>
                                <h1 class="title">Payment Receipt</h1>
                                <p class="subtitle">
                                    A premium confirmation of your recent payment and its applied invoice details.
                                </p>
                            </div>
                        </td>
                        <td style="width:35%;">
                            <div class="paid-box">
                                <div class="paid-label">Amount Received</div>
                                <p class="paid-value">
                                    @string.Format("{0:c}", Model.Payment.PaymentAmount)
                                </p>
                               @*  <div class="paid-note">
                                    Thank you for your payment. Your receipt details are listed below.
                                </div> *@
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="content">
                <div class="greeting-box">
                    <p class="customer">Dear @Model.Payee.PayeeName,</p>
                    <p class="greeting-text">
                        Thank you for your recent payment of
                        <strong>@string.Format("{0:c}", Model.Payment.PaymentAmount)</strong>.
                        Please find below the payment information and the invoices to which your payment has been applied.
                    </p>
                </div>

                <table class="payment-meta-table" role="presentation">
                    <tr>
                        <td style="width:33.33%;" class="meta-cell-left">
                            <div class="meta-card">
                                <div class="meta-label">Payment Type</div>
                                <div class="meta-value">@Model.Payment.PaymentMethod</div>
                            </div>
                        </td>
                        <td style="width:33.33%;" class="meta-cell-center">
                            <div class="meta-card">
                                <div class="meta-label">Payment Number</div>
                                <div class="meta-value">@Model.Payment.PaymentNumber</div>
                            </div>
                        </td>
                        <td style="width:33.33%;" class="meta-cell-right">
                            <div class="meta-card">
                                <div class="meta-label">Payment Date</div>
                                <div class="meta-value">
                                    @(Model.Payment.PaymentDate.HasValue? Model.Payment.PaymentDate.Value.ToString("D") : "")
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="width:100%; padding-top:15px;">
                            <div class="meta-card">
                                <div class="meta-label">Reference Number</div>
                                <div class="meta-value">@Model.Payment.ReferenceId</div>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="table-wrap">
                    <table class="receipt-lines">
                        <thead>
                            <tr>
                                <th style="width: 24%;">Invoice #</th>
                                <th style="width: 26%;">Invoice Date</th>
                                <th style="width: 20%; text-align:right;">Discount</th>
                                <th style="width: 30%; text-align:right;">Amount Applied</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payment.PaymentDetails != null && Model.Payment.PaymentDetails.Any())
                            {
                                foreach (var item in Model.Payment.PaymentDetails)
                                {
                                    <tr>
                                        <td class="invoice-no">@item.Sales?.SalesNumber</td>
                                        <td class="invoice-date">
                                            @if (item.Sales != null)
                                            {
                                                @string.Format("{0:MMM dd yyyy}", item.Sales.ShipDate)
                                            }
                                        </td>
                                        <td class="discount" style="text-align:right;">
                                            @string.Format("{0:c}", item.DiscountApplied)
                                        </td>
                                        <td class="payment-applied" style="text-align:right;">
                                            @string.Format("{0:c}", item.PaymentApplied)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; padding:30px; color:#6b7861;">
                                        No payment application details available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="total-label">Total Payment</td>
                                <td class="total-value" style="text-align:right;">
                                    @string.Format("{0:c}", Model.Payment.PaymentAmount)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="footer">
                    <p>
                        If you have any questions regarding this payment receipt, please do not hesitate to contact us. We are always happy to assist you.
                    </p>
                    <p>
                        Thank you again for your business and for the opportunity to serve you.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>