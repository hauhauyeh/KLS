@using KLS.Common
@model KLS.Models.RPTPoView

<style>
    @@media print {
        @@page {
            size: letter;
            margin-top: 0.2in;
            margin-bottom: 0.1in;
            margin-left: 0.2in;
            margin-right: 0.2in;
        }
    }

    body {
        margin: 0;
        font-size: 15px;
        font-family: Calibri;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 0;
        padding: 0;
        table-layout: fixed !important;
    }

    .header-height {
        height: 225px;
    }

    .footer-height {
        height: 70px;
    }

    /* important left Only Layout */
    /* .left-width {
                    width: 100%;
                } */

    .highlight-dark {
        background-color: #333333;
        color: white;
        font-size: 15px;
        font-weight: 800;
    }

    .highlight-small {
        background-color: #e6e6e6;
        border-radius: 4px;
        padding: 0px 6px 1px 6px;
    }

    .font10 {
        font-size: 10px;
    }

    .font11 {
        font-size: 11px;
    }

    .font12 {
        font-size: 12px;
    }

    .font13 {
        font-size: 13px;
    }

    .font14 {
        font-size: 14px;
    }

    .font15 {
        font-size: 15px;
    }

    .upparcase {
        text-transform: uppercase;
    }

    .font600 {
        font-weight: 600;
    }

    .chinese {
        font-family: 'Microsoft YaHei';
    }

    .text-left {
        text-align: left;
    }

    .text-center {
        text-align: center;
    }

    .text-right {
        text-align: right;
    }

    .no-overflow {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    /*INVOICE DETAIL*/
    .main-table tbody td {
        font-size: 14px;
        padding-bottom: 6px !important;
        vertical-align: top;
    }

    .main-table tr {
        page-break-inside: avoid;
        break-inside: avoid;
    }

        /*INVOICE DETAIL -> ITEM-HEADER*/
        .main-table tr.item-header {
            background-color: #333333;
        }

            .main-table tr.item-header td {
                color: white;
                font-size: 14px;
                font-weight: 500;
                padding: 2px;
            }

    /*INVOICE DETAIL -> GROUP-HEADER*/
    .invoice-item-group {
        background-color: grey;
        color: white;
        font-size: 14px;
        font-weight: 500;
        padding: 2px 10px 2px;
    }

    /*INVOICE HEADER*/
    .main-table-header-grid {
        position: fixed;
        top: 0;
        display: grid;
        grid-template-rows: 120px 110px; /* Two rows */
        grid-template-columns: 50% 10% 40%; /* Default column setting */
    }

    .comp-logo-grid {
        grid-column: 1 / span 2;
    }

    .comp-name {
        font-family: "Impact";
        /* font-size: 26px; */
        font-size: 18px;
        line-height: 1;
        padding-left: 10px;
        margin-bottom: 10px;
    }

    .comp-address {
        font-size: 12px;
        line-height: 1.3;
        padding-left: 10px;
    }

    .inv-info-grid {
        grid-column: 3 / span 1;
    }

    .invoice-barcode {
        font-family: 'Free 3 of 9' !important;
        font-size: 41px;
        text-align: center;
        padding-bottom: 6px;
    }

    .invoice-label {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .invoice-info-label {
        font-size: 11px !important;
        font-weight: bold;
        text-align: left;
        border: 1px solid;
        padding: 3px 5px !important;
    }

    .invoice-info {
        font-size: 12.5px;
        text-align: center;
        border: 1px solid;
        padding: 3px 5px !important;
    }

    .ship-to-grid {
        grid-column: 1 / span 3;
    }

    .ship-to-label {
        padding: 3px 5px;
        padding-left: 10px;
        margin-bottom: 5px;
    }

    .cust-name {
        font-size: 15px;
        font-weight: bold;
        line-height: 1.2;
        padding-left: 5px;
        padding-bottom: 3px;
    }

    .cust-address {
        font-size: 13px;
        padding-left: 5px;
        line-height: 1.3;
    }

    /*INVOICE FOOTER*/
    .main-table-footer-grid {
        position: fixed;
        bottom: 0;
        display: table;
    }

    .total-grid {
        width: 100%
    }

    .t2 {
        width: 100%;
        height: 100%;
        border-spacing: 0;
    }

        .t2 td {
            font-size: 14px;
            font-weight: bold;
            border: 1px solid black;
            padding-left: 3px;
            padding-right: 5px;
        }

    .d-flex {
        display: flex;
    }

    .justify-content-between {
        justify-content: space-between;
    }

    .justify-content-end {
        justify-content: end;
    }
</style>

