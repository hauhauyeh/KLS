@model KLS.Models.WelcomeEmail
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Account Is Ready</title>
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 40px 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at top left, #f8fcef 0%, #edf7df 40%, #e4f0d0 100%);
            color: #24311d;
        }

        .page-wrap { max-width: 900px; margin: 0 auto; }

        .mail-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfdf8 100%);
            border: 1px solid #dfe9cd;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 18px 44px rgba(48, 74, 18, 0.10), 0 4px 14px rgba(48, 74, 18, 0.06);
        }

        .top-accent {
            height: 8px;
            background: linear-gradient(90deg, #6f9f10 0%, #8fbe22 45%, #c7e57d 100%);
        }

        .header {
            padding: 36px 42px 28px;
            border-bottom: 1px solid #edf3e1;
            background: linear-gradient(135deg, rgba(143, 190, 34, 0.10), rgba(255,255,255,0) 45%);
        }

        .header-table { width: 100%; border-collapse: collapse; }
        .header-table td { vertical-align: top; border: none; padding: 0; }

        .eyebrow {
            display: inline-block;
            margin-bottom: 14px;
            padding: 7px 14px;
            border-radius: 999px;
            background: #eef7da;
            color: #5d8210;
            border: 1px solid #dce8c8;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.15px;
            text-transform: uppercase;
        }

        .title { margin: 0; font-size: 34px; font-weight: 800; color: #1f2b19; }
        .subtitle { margin: 10px 0 0; color: #66735c; font-size: 15px; line-height: 1.6; }

        .status-box {
            padding: 20px 24px;
            border-radius: 20px;
            border: 1px solid #dce8c8;
            background: linear-gradient(180deg, #f8fcef 0%, #eff6e2 100%);
        }

        .status-label { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #6b785f; margin-bottom: 8px; }
        .status-value { margin: 0; font-size: 22px; font-weight: 900; color: #256328; }

        .content { padding: 34px 42px 40px; }

        .welcome-box {
            margin-bottom: 28px;
            padding: 22px 24px;
            border-radius: 18px;
            background: #fcfef8;
            border: 1px solid #e8efdb;
            border-left: 5px solid #8fbe22;
        }

        .customer { margin: 0 0 8px 0; font-size: 20px; font-weight: 800; color: #293521; }
        .welcome-text { margin: 0; color: #5f6c56; font-size: 15px; line-height: 1.75; }

        .credentials-card {
            margin-bottom: 28px;
            padding: 24px;
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #fafdf5 100%);
            border: 1px solid #e5edd7;
            box-shadow: 0 4px 14px rgba(36, 49, 29, 0.04);
        }

        .cred-title { margin: 0 0 16px 0; font-size: 16px; font-weight: 800; color: #2b3724; }

        .cred-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 12px;
            background: #f4f9eb;
            border: 1px solid #dde8c7;
            margin-bottom: 10px;
        }

        .cred-label { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #6b7a5f; min-width: 80px; }
        .cred-value { font-size: 15px; font-weight: 700; color: #1f2b19; word-break: break-all; }

        .password-row {
            padding: 14px 16px;
            border-radius: 12px;
            background: #fff8e6;
            border: 1px solid #f0d98a;
            margin-bottom: 10px;
        }

        .password-value { font-size: 18px; font-weight: 900; color: #7a5a00; letter-spacing: 2px; font-family: monospace; }

        .button-wrap { margin: 28px 0 20px; text-align: center; }

        .login-btn {
            display: inline-block;
            padding: 15px 36px;
            border-radius: 999px;
            background: linear-gradient(90deg, #6f9f10 0%, #87b91a 100%);
            color: #ffffff !important;
            text-decoration: none;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.3px;
            box-shadow: 0 10px 24px rgba(90, 129, 22, 0.22);
        }

        .footer {
            margin-top: 24px;
            padding: 20px 24px;
            border-radius: 18px;
            border: 1px solid #e7efda;
            background: linear-gradient(180deg, #fcfef8 0%, #f6faef 100%);
        }

        .footer p { margin: 0 0 10px 0; color: #5d6a54; font-size: 14px; line-height: 1.75; }
        .footer p:last-child { margin-bottom: 0; }

        @@media only screen and (max-width: 768px) {
            .header, .content { padding: 24px; }
            .title { font-size: 26px; }
            .header-table, .header-table tbody, .header-table tr, .header-table td { display: block !important; width: 100% !important; }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="mail-card">
            <div class="top-accent"></div>

            <div class="header">
                <table class="header-table" role="presentation">
                    <tr>
                        <td style="width:65%; padding-right:20px;">
                            <div class="eyebrow">Account Created</div>
                            <h1 class="title">Your Account Is Ready</h1>
                            <p class="subtitle">
                                An account has been set up for you. Use the credentials below to sign in.
                            </p>
                        </td>
                        <td style="width:35%;">
                            <div class="status-box">
                                <div class="status-label">Account Status</div>
                                <p class="status-value">Active</p>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="content">
                <div class="welcome-box">
                    <p class="customer">Hello, @(Model.Username ?? "User"),</p>
                    <p class="welcome-text">
                        Your account has been created. Below are your login credentials.
                        We recommend changing your password after your first sign-in.
                    </p>
                </div>

                <div class="credentials-card">
                    <h3 class="cred-title">Your Login Credentials</h3>

                    <div class="cred-row">
                        <span class="cred-label">Email</span>
                        <span class="cred-value">@Model.Email</span>
                    </div>

                    <div class="cred-row">
                        <span class="cred-label">Username</span>
                        <span class="cred-value">@Model.Username</span>
                    </div>

                    <div class="password-row">
                        <div class="cred-label" style="margin-bottom:6px;">Temporary Password</div>
                        <div class="password-value">@Model.TempPassword</div>
                    </div>

                    <div class="button-wrap">
                        <a href="@Model.LoginUrl" class="login-btn">Sign In to Your Account</a>
                    </div>
                </div>

                <div class="footer">
                    <p>
                        For your security, please change your password after signing in for the first time.
                    </p>
                    <p>
                        If you did not expect this email or believe it was sent in error, please contact your account administrator.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
