@model KLS.Models.WelcomeEmail
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Account Is Ready</title>
    <partial name="_EmailTheme" />
    <style>
        .page-wrap { max-width: 900px; }
        .title { font-size: 34px; }

        .credentials-card {
            margin-bottom: 28px;
            padding: 24px;
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #f7f5ff 100%);
            border: 1px solid #e0daf0;
            box-shadow: 0 4px 14px rgba(87, 90, 255, 0.04);
        }

        .cred-title { margin: 0 0 16px 0; font-size: 16px; font-weight: 800; color: #2d2844; }

        .cred-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 12px;
            background: #f0edff;
            border: 1px solid #d6cef0;
            margin-bottom: 10px;
        }

        .cred-label { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #6b6680; min-width: 80px; }
        .cred-value { font-size: 15px; font-weight: 700; color: #1a1535; word-break: break-all; }

        .password-row {
            padding: 14px 16px;
            border-radius: 12px;
            background: #fff8e6;
            border: 1px solid #f0d98a;
            margin-bottom: 10px;
        }

        .password-value { font-size: 18px; font-weight: 900; color: #7a5a00; letter-spacing: 2px; font-family: monospace; }

        @@media only screen and (max-width: 768px) {
            .title { font-size: 26px; }
            .header-table, .header-table tbody, .header-table tr, .header-table td { display: block !important; width: 100% !important; }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="mail-card">
            <div class="top-accent"></div>

            <div class="header">
                <table class="header-table" role="presentation">
                    <tr>
                        <td style="width:65%; padding-right:20px;">
                            <div class="eyebrow">Account Created</div>
                            <h1 class="title">Your Account Is Ready</h1>
                            <p class="subtitle">
                                An account has been created for you. Click the button below to set your password and get started.
                            </p>
                        </td>
                        <td style="width:35%;">
                            <div class="summary-box">
                                <div class="summary-label">Account Status</div>
                                <p class="summary-value">Active</p>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="content">
                <div class="greeting-box">
                    <p class="customer">Hello, @(Model.Username ?? "User"),</p>
                    <p class="greeting-text">
                        Your account has been created. Please set your password using the link below to activate your account.
                    </p>
                </div>

                <div class="credentials-card">
                    <h3 class="cred-title">Your Account Details</h3>

                    <div class="cred-row">
                        <span class="cred-label">Email</span>
                        <span class="cred-value">@Model.Email</span>
                    </div>

                    <div class="cred-row">
                        <span class="cred-label">Username</span>
                        <span class="cred-value">@Model.Username</span>
                    </div>

                    <div class="button-wrap">
                        <a href="@Model.LoginUrl" class="action-btn">Set Your Password</a>
                    </div>
                </div>

                <div class="footer">
                    <p>
                        This link will expire in 24 hours. If it expires, please contact your account administrator.
                    </p>
                    <p>
                        If you did not expect this email or believe it was sent in error, please ignore it.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
