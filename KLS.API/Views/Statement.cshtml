@model KLS.Models.Reports.RptCustStmt
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@functions {
    private string DisplaySalesNumber(KLS.Models.Sales sales)
    {
        if (Model.UseSalesDocNumber && !string.IsNullOrWhiteSpace(sales.SalesDocNumber))
            return sales.SalesDocNumber;

        return sales.SalesNumber.ToString();
    }

    private bool IsBillToStatement()
    {
        return string.Equals(Model.StatementScope, "BillTo", StringComparison.OrdinalIgnoreCase);
    }

    private decimal StatementTotalDue()
    {
        return Model.StatementTotalDue
            ?? Model.Details?.Sum(g => g.Sales?.Sum(s => s.AmountDue ?? 0) ?? 0)
            ?? 0;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Statement</title>
    <partial name="_EmailTheme" />
    <style>
        .mail-card {
            box-shadow: 0 10px 30px rgba(87, 90, 255, 0.06), 0 2px 10px rgba(87, 90, 255, 0.04);
        }

        .header { padding: 38px 42px 24px; }
        .title { font-weight: 700; }

        .header-box {
            display: flex !important;
            justify-content: space-between !important;
        }

        .brand-block { min-width: 60%; }
        .summary-box { min-width: 260px; padding: 18px 22px; border-radius: 18px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.6); }

        .summary-total {
            font-size: 30px;
            font-weight: 800;
            color: #7a1f1f;
            margin: 0;
        }

        .summary-note {
            margin-top: 6px;
            font-size: 13px;
            color: #6b6680;
        }

        .table-wrap thead th { padding: 10px 10px; }
        .table-wrap tbody td { padding: 5px 10px; }

        .month-row td {
            background: linear-gradient(90deg, #f5f3ff 0%, #faf9ff 100%);
            font-weight: 700;
            color: #5b21b6;
            border-top: 1px solid #e4ddf0;
            border-bottom: 1px solid #e4ddf0;
            padding-top: 15px;
            padding-bottom: 15px;
        }

        .ship-to-row td {
            background: #f6f7fb;
            font-weight: 700;
            color: #4b5563;
            border-top: 1px solid #d7dce8;
            border-bottom: 1px solid #d7dce8;
            padding-top: 15px;
            padding-bottom: 15px;
        }

        .month-pill {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            background: #ede9fe;
            border: 1px solid #d6cef0;
            font-size: 13px;
            color: #6c47d6;
        }

        .scope-pill {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            background: #e3f2fd;
            border: 1px solid #90caf9;
            color: #1976d2;
            font-size: 13px;
            font-weight: 700;
            margin-top: 10px;
        }

        .amount {
            font-weight: 700;
            color: #2d2844;
            white-space: nowrap;
        }

        .amount-due {
            font-weight: 800;
            color: #7a1f1f;
            white-space: nowrap;
        }

        .sales-no {
            font-weight: 600;
            color: #5b527a;
        }

        .route-chip {
            display: inline-block;
            background: #f0edff;
            border: 1px solid #ddd6f0;
            color: #5b527a;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }

        .grand-total-label {
            text-align: right;
            font-size: 16px;
            font-weight: 800;
            color: #312e40;
        }

        .grand-total-value {
            font-size: 22px;
            font-weight: 900;
            color: #7a1f1f;
            white-space: nowrap;
        }

        @@media (max-width: 768px) {
            .summary-total { font-size: 24px; }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="mail-card">
            <div class="top-accent"></div>

            <div class="header">
                <div class="header-box">
                    <div class="brand-block">
                        @* Uncomment if needed *@
                        @* <partial name="_Header.cshtml" model="@Model.Company" /> *@

                        <div class="eyebrow">Customer Statement</div>
                        <h2 class="title">Account Statement</h2>
                        @if (IsBillToStatement())
                        {
                            <div class="scope-pill">Bill-To Statement</div>
                        }
                        <p class="subtitle">
                            A summary of outstanding sales transactions and balance due.
                        </p>
                    </div>

                    <div class="summary-box">
                        <div class="summary-label">Total Amount Due</div>
                        <p class="summary-total">
                            @string.Format("{0:c}", StatementTotalDue())
                        </p>
                        <div class="summary-note">
                            Please review the statement details below.
                        </div>
                    </div>
                </div>
            </div>

            <div class="content">
                <div class="greeting-box">
                    <p class="customer">Dear Customer,</p>
                    <p class="greeting-text">
                        @if (IsBillToStatement())
                        {
                            <text>Please find below the latest bill-to statement of your account. This summary includes outstanding sales grouped by ship-to customer.</text>
                        }
                        else
                        {
                            <text>Please find below the latest statement of your account. This summary includes outstanding sales grouped by shipping month for your convenience.</text>
                        }
                    </p>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 28%;">Ship Route</th>
                                <th style="width: 22%;">Ship Date</th>
                                <th style="width: 20%;">Sales #</th>
                                <th style="width: 30%; text-align:right;">Amount Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsBillToStatement() && Model.BillToGroups != null && Model.BillToGroups.Any())
                            {
                                foreach (var shipTo in Model.BillToGroups)
                                {
                                    <tr class="ship-to-row">
                                        <td colspan="4">
                                            Ship-To: @(shipTo.ShipToName ?? $"Customer #{shipTo.ShipId}")
                                        </td>
                                    </tr>

                                    if (shipTo.Sales != null)
                                    {
                                        foreach (var item in shipTo.Sales)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="route-chip">@item.ShipRoute</span>
                                                </td>
                                                <td>@string.Format("{0:MMM dd yyyy}", item.ShipDate)</td>
                                                <td class="sales-no">@DisplaySalesNumber(item)</td>
                                                <td style="text-align:right;" class="amount">
                                                    @string.Format("{0:c}", item.AmountDue)
                                                </td>
                                            </tr>
                                        }
                                    }

                                    <tr>
                                        <td colspan="3" class="grand-total-label">Ship-To Total</td>
                                        <td class="grand-total-value" style="text-align:right;">
                                            @string.Format("{0:c}", shipTo.ShipToTotal ?? 0)
                                        </td>
                                    </tr>
                                }
                            }
                            else if (Model.Details != null && Model.Details.Any())
                            {
                                foreach (var grpMonth in Model.Details)
                                {
                                    <tr class="month-row">
                                        <td colspan="3">
                                            <span class="month-pill">@grpMonth.ShipMonth</span>
                                        </td>
                                        <td style="text-align:right;" class="amount-due">
                                            @string.Format("{0:c}", grpMonth.Sales.Sum(c => c.AmountDue))
                                        </td>
                                    </tr>

                                    foreach (var item in grpMonth.Sales)
                                    {
                                        <tr>
                                            <td>
                                                <span class="route-chip">@item.ShipRoute</span>
                                            </td>
                                            <td>@string.Format("{0:MMM dd yyyy}", item.ShipDate)</td>
                                            <td class="sales-no">@DisplaySalesNumber(item)</td>
                                            <td style="text-align:right;" class="amount">
                                                @string.Format("{0:c}", item.AmountDue)
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; padding:30px; color:#6b6680;">
                                        No statement details available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="grand-total-label">Total Amount Due</td>
                                <td class="grand-total-value" style="text-align:right;">
                                    @string.Format("{0:c}", StatementTotalDue())
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="footer">
                    <p>
                        If you have any questions regarding this statement, our team will be happy to assist you.
                    </p>
                    <p>
                        We sincerely appreciate your continued business and trust.
                    </p>
                    <p class="signature">Thank you.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
