@model KLS.Models.WelcomeEmail
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email</title>
    <partial name="_EmailTheme" />
    <style>
        .page-wrap { max-width: 900px; }
        .title { font-size: 36px; }
        .summary-value { font-size: 24px; }

        .status-note {
            margin-top: 8px;
            color: #6b6680;
            font-size: 13px;
            line-height: 1.5;
        }

        .info-card {
            margin-bottom: 28px;
            padding: 22px 24px;
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #f7f5ff 100%);
            border: 1px solid #e0daf0;
            box-shadow: 0 4px 14px rgba(87, 90, 255, 0.04);
        }

        .info-title {
            margin: 0 0 10px 0;
            font-size: 16px;
            font-weight: 800;
            color: #2d2844;
        }

        .info-text {
            margin: 0;
            color: #5d5a6e;
            font-size: 14px;
            line-height: 1.8;
        }

        .link-card {
            margin-top: 10px;
            padding: 18px 20px;
            border-radius: 16px;
            background: #f7f5ff;
            border: 1px dashed #d6cef0;
        }

        .link-label {
            margin: 0 0 8px 0;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #6b6680;
        }

        .link-text {
            margin: 0;
            font-size: 13px;
            line-height: 1.8;
            color: #5b527a;
            word-break: break-all;
        }

        @@media only screen and (max-width: 768px) {
            .summary-value { font-size: 22px; }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="mail-card">
            <div class="top-accent"></div>

            <div class="header">
                <table class="header-table" role="presentation">
                    <tr>
                        <td style="width:65%;">
                            <div class="title-block">
                                <div class="eyebrow">Account Registration</div>
                                <h1 class="title">Set Your Password</h1>
                                <p class="subtitle">
                                    Welcome to your new account. Please set your password to complete your registration.
                                </p>
                            </div>
                        </td>
                        <td style="width:35%;">
                            <div class="summary-box">
                                <div class="summary-label">Account Status</div>
                                <p class="summary-value">Pending Setup</p>
                                <div class="status-note">
                                    Click the button below to set your password and activate your account.
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="content">
                <div class="greeting-box">
                    <p class="customer">Dear @(Model.Username ?? "Customer"),</p>
                    <p class="greeting-text">
                        Thank you for registering with us. To complete your account setup, please set your password by clicking the button below.
                    </p>
                </div>

                <div class="info-card">
                    <h3 class="info-title">Complete Your Registration</h3>
                    <p class="info-text">
                        Click the button below to choose your password. This link will expire in 24 hours.
                    </p>

                    <div class="button-wrap">
                        <a href="@Model.LoginUrl" class="action-btn">Set Your Password</a>
                    </div>
                </div>

                <div class="footer">
                    <p>
                        If you did not create this account, you may safely ignore this email.
                    </p>
                    <p>
                        For security reasons, we recommend verifying your email as soon as possible.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
