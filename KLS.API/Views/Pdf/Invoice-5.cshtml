@using KLS.Common
@using KLS.Models
@using KLS.Models.Reports
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@model RptInvoice
@{
    var invoice = Model.Invoice;
    var details = (Model.InvoiceDetails ?? new List<InvoiceDetail>())
        .Where(d => !d.IsGroup)
        .ToList();
    var caseItems = details
        .Where(d => string.Equals(d.Unit?.Trim(), "CS", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var splitItems = details
        .Where(d => !string.Equals(d.Unit?.Trim(), "CS", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var statementDetails = Model.Statement?.Details ?? new List<RptCustStmtDetail>();
    var salesNumber = invoice?.SalesNumber.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
}

@functions {
    private static string JoinParts(params string?[] parts)
    {
        return string.Join(", ", parts.Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!.Trim()));
    }

    private static string Qty(decimal? value)
    {
        return value.HasValue ? string.Format(CultureInfo.InvariantCulture, "{0:0.##}", value.Value) : string.Empty;
    }

    private static string Amount(decimal? value)
    {
        return value.HasValue ? string.Format(CultureInfo.InvariantCulture, "{0:0.00}", value.Value) : string.Empty;
    }

    private static string DateText(DateOnly? value)
    {
        return value.HasValue ? value.Value.ToString("M/d/yyyy", CultureInfo.InvariantCulture) : string.Empty;
    }

    private static string Money(decimal? value)
    {
        return string.Format(CultureInfo.CurrentCulture, "{0:c}", value ?? 0m);
    }
}

<style>
    @@media print {
        @@page {
            size: letter;
            margin: 0;
        }
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        color: #111;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        line-height: 1.18;
    }

    .mgp-page {
        position: relative;
        width: 8.5in;
        height: 11in;
        overflow: hidden;
        background: transparent;
    }

    .barcode {
        position: absolute;
        top: 0.18in;
        right: 0.74in;
        width: 1.86in;
        height: 0.28in;
        font-family: 'IDAutomationUPCEANXXS' !important;
        font-size: 30px;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
    }

    .route-box {
        position: absolute;
        top: 0.66in;
        right: 0.58in;
        width: 0.42in;
        height: 0.34in;
        border: 1px solid #c8c8c8;
        text-align: center;
        font-size: 22px;
        line-height: 0.32in;
    }

    .address-left {
        position: absolute;
        top: 1.28in;
        left: 1.03in;
        width: 2.55in;
        min-height: 0.72in;
        font-size: 14px;
    }

    .billto-block {
        position: absolute;
        top: 1.32in;
        left: 5.48in;
        width: 2.15in;
        min-height: 0.34in;
        font-size: 16px;
        font-weight: 700;
    }

    .instruction-block {
        position: absolute;
        top: 1.72in;
        left: 5.48in;
        width: 2.15in;
        min-height: 0.22in;
        font-size: 15px;
    }

    .name {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 0.02in;
    }

    .meta-row {
        position: absolute;
        top: 2.63in;
        left: 0.52in;
        right: 0.72in;
        display: grid;
        grid-template-columns: 1.2in 1.35in 1.15in 1.0in 1.18in 1.08in;
        column-gap: 0.24in;
        align-items: center;
        font-size: 15px;
    }

    .meta-row div {
        white-space: nowrap;
    }

    .items-area {
        position: absolute;
        top: 3.13in;
        left: 0.29in;
        width: 5.73in;
        min-height: 2.15in;
    }

    .section-bar {
        width: 100%;
        height: 0.22in;
        padding-left: 0.54in;
        background: #d0cdcd;
        color: #fff;
        font-size: 15px;
        font-style: italic;
        font-weight: 700;
        line-height: 0.22in;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .item-table {
        margin: 0.05in 0 0.06in;
    }

    .item-table td {
        padding: 0.025in 0.03in;
        vertical-align: top;
        font-size: 12px;
        line-height: 1.15;
        white-space: nowrap;
    }

    .item-table .qty {
        width: 0.35in;
        text-align: right;
    }

    .item-table .unit {
        width: 0.42in;
    }

    .item-table .code {
        width: 0.70in;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .item-table .desc {
        width: 2.24in;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .item-table .pack {
        width: 0.66in;
    }

    .item-table .price {
        width: 0.56in;
        text-align: right;
    }

    .item-table .ext {
        width: 0.66in;
        text-align: right;
    }

    .statement-area {
        position: absolute;
        top: 3.28in;
        right: 0.36in;
        width: 2.18in;
    }

    .statement-table {
        table-layout: fixed;
    }

    .statement-table td {
        font-size: 9px;
        line-height: 1.05;
        padding: 0.006in 0;
        white-space: nowrap;
    }

    .statement-current-row td {
        font-weight: 700;
    }

    .statement-date {
        width: 0.65in;
    }

    .statement-number {
        width: 0.72in;
        text-align: right;
    }

    .statement-amount {
        width: 0.78in;
        text-align: right;
    }

    .statement-total-label {
        padding-top: 0.05in !important;
        text-align: right;
    }

    .invoice-total {
        position: absolute;
        left: 5.25in;
        bottom: 0.74in;
        width: 0.95in;
        font-size: 20px;
        text-align: center;
        white-space: nowrap;
    }
</style>

<div class="mgp-page">
    <div class="barcode">*@salesNumber*</div>
    <div class="route-box">@invoice?.ShipRoute</div>

    <div class="address-left">
        <div class="name">@invoice?.ShipName</div>
        <div>@invoice?.ShipAddress</div>
        <div>@JoinParts(invoice?.ShipCity, invoice?.ShipState, invoice?.ShipZipCode)</div>
        <div>@invoice?.ShipPhone1</div>
    </div>

    <div class="billto-block">@invoice?.BillName</div>
    <div class="instruction-block">@invoice?.Instruction</div>

    <div class="meta-row">
        <div>@invoice?.ShipId</div>
        <div></div>
        <div>@invoice?.TermName</div>
        <div>@invoice?.ShipRoute</div>
        <div>@DateText(invoice?.ShipDate)</div>
        <div>@salesNumber</div>
    </div>

    <div class="items-area">
        @if (caseItems.Count > 0)
        {
            <div class="section-bar">Cases</div>
            <table class="item-table">
                <tbody>
                    @foreach (var item in caseItems)
                    {
                        <tr>
                            <td class="qty">@Qty(item.ShipQty)</td>
                            <td class="unit">@item.Unit</td>
                            <td class="code">@item.ItemCode</td>
                            <td class="desc">@item.ItemName</td>
                            <td class="pack">@item.PackSize</td>
                            <td class="price">@Amount(item.UnitPrice)</td>
                            <td class="ext">@Amount(item.ExtTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (splitItems.Count > 0)
        {
            <div class="section-bar">Split Items</div>
            <table class="item-table">
                <tbody>
                    @foreach (var item in splitItems)
                    {
                        <tr>
                            <td class="qty">@Qty(item.ShipQty)</td>
                            <td class="unit">@item.Unit</td>
                            <td class="code">@item.ItemCode</td>
                            <td class="desc">@item.ItemName</td>
                            <td class="pack">@item.PackSize</td>
                            <td class="price">@Amount(item.UnitPrice)</td>
                            <td class="ext">@Amount(item.ExtTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="statement-area">
        @if (statementDetails.Count > 0)
        {
            <table class="statement-table">
                <tbody>
                    @foreach (var month in statementDetails)
                    {
                        var monthName = month.ShipMonth?.Split(' ').FirstOrDefault();
                        if (month.Sales != null)
                        {
                            foreach (var sale in month.Sales)
                            {
                                var currentRowClass = sale.SalesId == invoice?.SalesId ? "statement-current-row" : null;
                                <tr class="@currentRowClass">
                                    <td class="statement-date">@DateText(sale.ShipDate)</td>
                                    <td class="statement-number">@Model.GetSalesDisplayNumber(sale)</td>
                                    <td class="statement-amount">@Money(sale.AmountDue)</td>
                                </tr>
                            }
                        }
                        <tr>
                            <td colspan="2" class="statement-total-label">Total of @monthName</td>
                            <td class="statement-amount">@Money(month.MonthTotal)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="2" class="statement-total-label">Grand Total:</td>
                        <td class="statement-amount">@Money(Model.Statement?.StatementTotalDue)</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>

    <div class="invoice-total">@Amount(invoice?.SalesTotal)</div>
</div>
