@using KLS.Common
@using KLS.Models.Reports
@model RptPOView

<style>
    @@media print {
        @@page {
            size: letter;
            margin-top: 0.2in;
            margin-bottom: 0.1in;
            margin-left: 0.2in;
            margin-right: 0.2in;
        }
    }

    body {
        margin: 0;
        font-size: 15px;
        font-family: Calibri;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 0;
        padding: 0;
        table-layout: fixed !important;
    }

    .header-height {
        height: 225px;
    }

    .footer-height {
        height: 70px;
    }

    /* Layout helper previously inline */
    .left-width {
        width: 100%;
    }

    .highlight-dark {
        background-color: #333333;
        color: white;
        font-size: 15px;
        font-weight: 800;
    }

    .highlight-small {
        background-color: #e6e6e6;
        border-radius: 4px;
        padding: 0px 6px 1px 6px;
    }

    .font10 {
        font-size: 10px;
    }

    .font11 {
        font-size: 11px;
    }

    .font12 {
        font-size: 12px;
    }

    .font13 {
        font-size: 13px;
    }

    .font14 {
        font-size: 14px;
    }

    .font15 {
        font-size: 15px;
    }

    .upparcase {
        text-transform: uppercase;
    }

    .font600 {
        font-weight: 600;
    }

    .chinese {
        font-family: 'Microsoft YaHei';
    }

    .text-left {
        text-align: left;
    }

    .text-center {
        text-align: center;
    }

    .text-right {
        text-align: right;
    }

    .no-overflow {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    /*INVOICE DETAIL*/
    .main-table tbody td {
        font-size: 14px;
        padding-bottom: 6px !important;
        vertical-align: top;
    }

    .main-table tr {
        page-break-inside: avoid;
        break-inside: avoid;
    }

        /*INVOICE DETAIL -> ITEM-HEADER*/
        .main-table tr.item-header {
            background-color: #333333;
        }

            .main-table tr.item-header td {
                color: white;
                font-size: 14px;
                font-weight: 500;
                padding: 2px;
            }

    /*INVOICE DETAIL -> GROUP-HEADER*/
    .invoice-item-group {
        background-color: grey;
        color: white;
        font-size: 14px;
        font-weight: 500;
        padding: 2px 10px 2px;
    }

    /*INVOICE HEADER*/
    .main-table-header-grid {
        position: fixed;
        top: 0;
        display: grid;
        grid-template-rows: 120px 110px; /* Two rows */
        grid-template-columns: 50% 10% 40%; /* Default column setting */
    }

    .comp-logo-grid {
        grid-column: 1 / span 2;
    }

    .comp-name {
        font-family: "Impact";
        /* font-size: 26px; */
        font-size: 18px;
        line-height: 1;
        padding-left: 10px;
        margin-bottom: 10px;
    }

    .comp-address {
        font-size: 12px;
        line-height: 1.3;
        padding-left: 10px;
    }

    .inv-info-grid {
        grid-column: 3 / span 1;
    }

    .invoice-barcode {
        font-family: 'Free 3 of 9' !important;
        font-size: 41px;
        text-align: center;
        padding-bottom: 6px;
    }

    .invoice-label {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .invoice-info-label {
        font-size: 11px !important;
        font-weight: bold;
        text-align: left;
        border: 1px solid;
        padding: 3px 5px !important;
    }

    .invoice-info {
        font-size: 12.5px;
        text-align: center;
        border: 1px solid;
        padding: 3px 5px !important;
    }

    .ship-to-grid {
        grid-column: 1 / span 3;
    }

    .ship-to-label {
        padding: 3px 5px;
        padding-left: 10px;
        margin-bottom: 5px;
    }

    .cust-name {
        font-size: 15px;
        font-weight: bold;
        line-height: 1.2;
        padding-left: 5px;
        padding-bottom: 3px;
    }

    .cust-address {
        font-size: 13px;
        padding-left: 5px;
        line-height: 1.3;
    }

    /*INVOICE FOOTER*/
    .main-table-footer-grid {
        position: fixed;
        bottom: 0;
        display: table;
    }

    .total-grid {
        width: 100%
    }

    .t2 {
        width: 100%;
        height: 100%;
        border-spacing: 0;
    }

        .t2 td {
            font-size: 14px;
            font-weight: bold;
            border: 1px solid black;
            padding-left: 3px;
            padding-right: 5px;
        }

    .d-flex {
        display: flex;
    }

    .justify-content-between {
        justify-content: space-between;
    }

    .justify-content-end {
        justify-content: end;
    }

    /* ---- MOVED INLINE HELPERS ---- */

    /* Company name text that was inline on the <span> */
    .company-name-text {
        font-family: 'Segoe UI';
        font-size: 24px;
        font-weight: bolder;
        display: inline-block;
        line-height: 1;
    }

    /* Logo sizing moved from inline height attr */
    .img-logo {
        height: 45px;
        max-width: 100%;
        object-fit: contain;
    }

    /* Replaces inline col widths used in table colgroups */
    .col-10 {
        width: 10%;
    }

    .col-15 {
        width: 15%;
    }

    .col-17 {
        width: 17%;
    }

    .col-22 {
        width: 22%;
    }

    .col-40 {
        width: 40%;
    }

    .col-45 {
        width: 45%;
    }

    .col-50 {
        width: 50%;
    }

    .col-60 {
        width: 60%;
    }

    .col-100 {
        width: 100%;
    }

    /* small helpers for table cells if needed (keeps existing behavior) */
    .td-text-right {
        text-align: right;
    }

    .td-text-left {
        text-align: left;
    }
</style>

<!-- Left Only -->
<div>
    <table class="main-table">
        <colgroup>
            <col class="col-10" />
            <col class="col-15" />
            <col class="col-45" />
            <col class="col-15" />
            <col class="col-15" />
        </colgroup>
        <thead>
            <tr>
                <td colspan="5"><div class="header-height">&nbsp;</div></td>
            </tr>
            <tr class="item-header">
                <td>Qty</td>
                <td>Code</td>
                <td>Description</td>
                <td class="text-right">Price</td>
                <td class="text-right">Ext Price</td>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.RptPODetail.Count; i++)
            {
                var itm = Model.RptPODetail[i];

                <tr>
                    <td class="no-overflow"><strong>@string.Format("{0:0.##}", itm.OrdQty0)</strong> @itm.Unit</td>
                    <td><span>@itm.ItemCode</span></td>
                    <td>
                        @* If you want item desc back in the layout, uncomment and style accordingly *@
                        <div style="line-height:1;">
                            <strong>@itm.ItemName</strong><br />
                            @if (Model.IsChineseShow)
                            {
                                <span class="chinese font10"></span>
                                <span>&nbsp;</span>
                                <span class="font11 upparcase">@itm.PackSize</span>
                            }
                            else
                            {
                                <span class="font11 upparcase">@itm.PackSize</span>
                            }
                        </div>
                    </td>
                    <td class="text-right">@Utilities.FormatPrice(itm.BillPrice, Model.PriceDecimals)</td>
                    <td class="text-right">
                        @string.Format("{0:c}", itm.BillTotal)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5"><div class="footer-height">&nbsp;</div></td>
            </tr>
        </tfoot>
    </table>

    <div class="main-table-header-grid left-width header-height">
        <div class="comp-logo-grid">
            <div class="comp-name">
                <div>
                    @if (Model.Company.HasLogo)
                    {
                        <img src="@Model.Company.LogoUrl" class="img-fluid img-logo" alt="Company logo" />
                    }
                    else
                    {
                        <span class="company-name-text">@Model.Company.CompanyName</span>
                    }
                </div>
            </div>
            <div class="comp-address">
                @Model.Company.AddressLine1<br />
                @Model.Company.City @Model.Company.State
                @Model.Company.ZipCode<br />
                @Model.Company.Phone<br />
                <strong>@Model.Company.Website</strong>
            </div>
        </div>

        <div class="inv-info-grid">
            <div class="d-flex justify-content-between">
                <div class="invoice-label">Purchase Order</div>
                <div class="invoice-barcode">
                    *@Model.RptPO.PurchaseNumber*
                </div>
            </div>
            <table>
                <colgroup>
                    <col class="col-40" />
                    <col class="col-60" />
                </colgroup>
                <tr>
                    <td class="invoice-info-label">Doc #</td>
                    <td class="invoice-info">@Model.RptPO.VendorDocNumber</td>
                </tr>
                <tr>
                    <td class="invoice-info-label">Order Date</td>
                    <td class="invoice-info">@string.Format("{0:d}", Model.RptPO.PurchaseDate)</td>
                </tr>
                <tr>
                    <td class="invoice-info-label">Estimate Arrival Date</td>
                    <td class="invoice-info">@string.Format("{0:d}", Model.RptPO.ArrivalDate)</td>
                </tr>
            </table>
        </div>

        <div class="ship-to-grid">
            <div class="ship-to-label highlight-dark">Vendor Information</div>
            <div class="cust-name">
                @Model.RptPO.PayeeName
            </div>
            <div class="cust-address">
                @Model.RptPO.Address<br />
                @Model.RptPO.City @Model.RptPO.State @Model.RptPO.ZipCode @Model.RptPO.Country<br />
                @Model.RptPO.Phone1
            </div>
        </div>
    </div>

    <div class="main-table-footer-grid footer-height">
        <div class="total-grid">
            <table class="t2">
                <colgroup>
                    <col class="col-17" />
                    <col class="col-17" />
                    <col class="col-22" />
                    <col class="col-22" />
                    <col class="col-22" />
                </colgroup>
                <tr>
                    <td>Total Item</td>
                    <td>Total Case</td>
                    <td class="text-right">Total Weight</td>
                    <td class="text-right">Total Volume</td>
                    <td class="text-right">Total</td>
                </tr>
                <tr>
                    <td>@Model.TotalItems</td>
                    <td>
                        @string.Format("{0:0.00}", Model.TotalCases)
                    </td>
                    <td class="text-right">
                        @Model.TotalWeight lbs
                    </td>
                    <td class="text-right">
                        @string.Format("{0:0.00}", Model.TotalVolume) cbm
                    </td>
                    <td class="text-right">@string.Format("{0:c}", Model.RptPODetail.Sum(c => c.BillTotal))</td>
                </tr>
            </table>
        </div>
    </div>
</div>
