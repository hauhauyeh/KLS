@using KLS.Common
@using KLS.Models.Reports
@model RptInvoice
@{
    var colSpan = 4;
    var isDropShipPickTicket = Model.Invoice?.IsDropShip == true;
    var routeInfoTruckLabel = isDropShipPickTicket ? "Container #" : "Truck #";
    var routeInfoTruckValue = isDropShipPickTicket ? Model.Invoice?.DropShipPurchaseContainerNumber : Model.Invoice?.TruckNumber;
    var routeInfoDriverLabel = isDropShipPickTicket ? "" : "Driver";
    var routeInfoDriverValue = isDropShipPickTicket ? "" : Model.Invoice?.DriverName;
}

<style>

    @@media print {
        @@page {
            size: letter;
            margin-top: 0.2in;
            margin-bottom: 0.1in;
            margin-left: 0.2in;
            margin-right: 0.2in;
        }
    }

    body {
        margin: 0;
        font-size: 15px;
        font-family: Calibri;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 0;
        padding: 0;
        table-layout: fixed !important;
    }

    .header-height {
        height: 279px;
    }

    .footer-height {
        height: 150px;
    }

    .left-width {
        width: 100%;
    }

    .highlight-dark {
        background-color: #333333;
        color: white;
        font-size: 15px;
        font-weight: 800;
    }

    .highlight-small {
        background-color: #e6e6e6;
        border-radius: 4px;
        padding: 0px 6px 1px 6px;
    }

    .font10 {
        font-size: 10px;
    }

    .font11 {
        font-size: 11px;
    }

    .font12 {
        font-size: 12px;
    }

    .upparcase {
        text-transform: uppercase;
    }

    .font600 {
        font-weight: 600;
    }

    .chinese {
        font-family: 'Microsoft YaHei';
    }

    .text-left {
        text-align: left;
    }

    .text-center {
        text-align: center;
    }

    .text-right {
        text-align: right;
    }

    .no-overflow {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .item-code-cell {
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    /*INVOICE DETAIL*/
    .main-table tbody td {
        font-size: 14px;
        padding-bottom: 4px !important;
        vertical-align: top;
    }

    .main-table thead tr.item-header {
        background-color: #333333;
    }

        .main-table thead tr.item-header td {
            color: white;
            font-size: 14px;
            font-weight: 500;
            padding: 4px;
        }

    /*INVOICE DETAIL -> GROUP-HEADER*/
    .invoice-item-group {
        background-color: grey;
        color: white;
        font-size: 14px;
        font-weight: 500;
        padding: 2px 10px 2px;
    }

    /*INVOICE HEADER*/
    .main-table-header-grid {
        position: fixed;
        top: 0;
        display: grid;
        grid-template-rows: 34px 135px 110px;
        grid-template-columns: 45% 30% 25%; /* Default column setting */
    }

    .company-display-title {
        grid-column: 1 / span 3;
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        line-height: 34px;
        font-family: "Segoe UI", Calibri, Arial, sans-serif;
    }

    .comp-logo-grid {
        grid-column: 1 / span 1;
    }

    .comp-name {
        font-family: "Impact";
        /* font-size: 26px; */
        font-size: 18px;
        line-height: 1;
        padding-left: 10px;
        margin-bottom: 10px;
    }

    .comp-logo-grid img {
        max-height: 58px;
        max-width: 220px;
    }

    .comp-address {
        font-size: 12px;
        line-height: 1.3;
        padding-left: 10px;
    }

    .inv-info-grid {
        grid-column: 2 / span 1;
    }

    .route-info-grid {
        grid-column: 3 / span 1;
        padding-left: 15px;
    }

    .invoice-label {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .invoice-info-label {
        font-size: 11px !important;
        font-weight: bold;
        text-align: left;
        border: 1px solid;
        padding: 3px 5px !important;
    }

    .invoice-info {
        font-size: 12.5px;
        text-align: center;
        border: 1px solid;
        padding: 3px 5px !important;
    }

    .ship-to-grid {
        grid-column: 1 / span 2;
    }

    .ship-to-label {
        padding: 3px 5px;
        padding-left: 10px;
        margin-bottom: 5px;
    }

    .cust-name {
        font-size: 15px;
        font-weight: bold;
        line-height: 1.2;
        padding-left: 5px;
        padding-bottom: 3px;
    }

    .cust-address {
        font-size: 13px;
        padding-left: 5px;
        line-height: 1.3;
    }

    .instruction-grid {
        grid-column: 3 / span 1;
    }

    .instruction-label {
        padding: 3px 5px;
        padding-left: 0px;
        margin-bottom: 3px;
    }

    .instruction {
        font-size: 11px;
        line-height: 1.1;
        padding-left: 5px;
    }

    /*INVOICE FOOTER*/
    .main-table-footer-grid {
        position: fixed;
        bottom: 0;
        display: grid;
        grid-template-rows: 20px 80px 60px; /* 3 rows */
        grid-template-columns: 40% 35% 25%; /* Default column setting */
    }

    .driver-note-grid {
        grid-column: 1 / span 3;
        text-align: center;
        font-size: 14px;
    }

    .payment-grid {
        grid-column: 1 / span 1;
    }

    .t1 {
        width: 100%;
        height: 100%;
        border-spacing: 0;
    }

        .t1 td {
            font-size: 12px;
            border: 1px solid black;
            padding: 5px;
        }

    .Signature-grid {
        border-top: 1px solid black;
        border-bottom: 1px solid black;
        grid-column: 2 / span 1;
    }

    .total-grid {
        grid-column: 3 / span 1;
    }

    .t2 {
        width: 100%;
        height: 100%;
        border-spacing: 0;
    }

        .t2 td {
            font-size: 12px;
            font-weight: bold;
            border: 1px solid black;
            /* width: 50%; */
            padding-left: 3px;
            padding-right: 5px;
        }

    .fineprint-grid {
        grid-column: 1 / span 3;
        margin-top: 2px;
        text-align: justify;
        font-size: 9px;
        line-height: 1.1;
        color: #333333 !important;
    }

    /*******************/
    /* INVOICE SIDEBAR */
    /*******************/

    .invoice-barcode {
        font-family: 'Free 3 of 9' !important;
        font-size: 41px;
        text-align: center;
        padding-bottom: 6px;
    }

    .route-info-table {
        margin-bottom: 9px;
    }

        .route-info-table td {
            border: 1px solid;
            padding: 3px 5px;
        }

    .route-info-label {
        font-size: 11px;
        font-weight: bold;
        text-align: left;
    }

    .route-info {
        font-size: 12.5px;
        text-align: center;
    }

    .load-separate {
        background-color: black;
        color: white;
        border-radius: 5px;
        padding: 0px 10px;
    }

    .statement-label {
        text-align: center;
        padding: 3px 5px;
    }

    .statement-table {
        margin-top: 5px;
        margin-bottom: 10px;
        table-layout: auto !important;
    }

        .statement-table td {
            font-size: 11px;
            padding: 2px 5px;
            white-space: nowrap;
        }

    .promo-header {
        background-color: black;
        color: white;
        font-size: 16px !important;
        line-height: 1.3;
        font-weight: bold;
        border-radius: 4px;
        text-align: center;
        padding: 3px;
        margin-bottom: 6px;
    }

    .promo-card {
        margin-bottom: 10px;
        border-radius: 4px;
        border: 1px grey solid;
        padding: 6px;
        line-height: 1.5;
        font-family: 'segoe ui';
        font-size: 12px;
        font-weight: bold;
        page-break-inside: avoid;
    }

    .promo-name {
        font-family: "Arial";
        font-size: 12px;
        font-style: italic;
        padding-bottom: 3px;
    }

    .promo-desc {
        padding-left: 5px;
    }

    .promo-desc2 {
    }

    .d-flex {
        display: flex;
    }

    .justify-content-between {
        justify-content: space-between;
    }

    .justify-content-end {
        justify-content: end;
    }

    .upc-code {
        font-family: 'IDAutomationUPCEANXXS' !important;
        font-size: 16px;
        text-align: center;
    }
</style>

<div style="display: flex;">
    <div class="left-width">
        <table class="main-table">
            <colgroup>
                <col style="width: 15%;">
                <col style="width: 15%;">
                <col style="width: 55%;">
                <col style="width: 15%;">
            </colgroup>
            <thead>
                <tr>
                    <td colspan="@colSpan"><div class="header-height">&nbsp;</div></td>
                </tr>
                <tr class="item-header">
                    <td>Code</td>
                    <td>Qty</td>
                    <td>Description</td>
                    <td>UPC</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var itmdetail in Model.InvoiceDetails)
                {
                    if (itmdetail.IsGroup)
                    {
                        @* <tr>
                            <td colspan="@colSpan">
                                <div class="invoice-item-group">@itmdetail.ItemDesc1</div>
                            </td>
                        </tr> *@
                    }
                    else
                    {
                        <tr>
                            <td class="item-code-cell"><span>@itmdetail.ItemCode</span></td>
                            <td class="no-overflow"><strong>@string.Format("{0:0.##}", itmdetail.ShipQty)</strong> @itmdetail.Unit</td>
                            <td>
                                <span style="line-height:1;">
                                    <strong>@itmdetail.ItemName</strong><br />
                                    <span class="font10 chinese">@itmdetail.ItemName2</span>&nbsp;
                                    <span class="font10 upparcase">@itmdetail.PackSize</span>
                                    @if (!string.IsNullOrEmpty(itmdetail.Notes))
                                    {
                                        <span class="highlight-small font12">
                                            @itmdetail.Notes
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(itmdetail.FIFOHistory))
                                    {
                                        <span class="font12">
                                            @itmdetail.FIFOHistory
                                        </span>
                                    }
                                </span>
                            </td>
                            <td class="text-center"><span class="upc-code">@itmdetail.EncodedBarcode</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="main-table-header-grid left-width header-height">
            <div class="company-display-title">@Model.Company.CompanyName</div>

            <div class="comp-logo-grid">
                <div class="comp-name">
                    <div>
                        @if (Model.Company.HasLogo)
                        {
                            <img src="@Model.Company.LogoUrl" class="img-fluid" />
                        }
                        else
                        {
                            <span>@Model.Company.CompanyName</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Company.CompanyName2))
                    {
                        <div style="font-size: 12px; margin-top: 2px;">@Model.Company.CompanyName2</div>
                    }
                </div>
                <div class="comp-address">
                    @Model.Company.AddressLine1<br />
                    @Model.Company.City @Model.Company.State
                    @Model.Company.ZipCode<br />
                    @Model.Company.Phone<br />
                    <strong>@Model.Company.Website</strong>
                </div>
            </div>
            <div class="inv-info-grid">
                <div class="d-flex justify-content-between">
                    <div class="invoice-label">Packing Slip</div>
                </div>
                <table>
                    <colgroup>
                        <col style="width: 40%;">
                        <col style="width: 60%;">
                    </colgroup>
                    <tr>
                        <td class="invoice-info-label">Invoice #</td>
                        <td class="invoice-info">@Model.SalesDisplayNumber</td>
                    </tr>
                    <tr>
                        <td class="invoice-info-label">Invoice Date</td>
                        <td class="invoice-info">@string.Format("{0:d}", Model.Invoice.ShipDate)</td>
                    </tr>
                    <tr>
                        <td class="invoice-info-label">Terms</td>
                        <td class="invoice-info" style="white-space:nowrap;">
                            @Model.Invoice.TermName
                        </td>
                    </tr>
                    <tr>
                        <td class="invoice-info-label">PO</td>
                        @if (string.IsNullOrEmpty(Model.Invoice.CustPONumber))
                        {
                            <td class="invoice-info">&nbsp;</td>
                        }
                        else
                        {
                            <td class="invoice-info">@Model.Invoice.CustPONumber</td>
                        }
                    </tr>
                </table>
            </div>
            <div class="route-info-grid">
                <div class="d-flex justify-content-end">
                    <div class="invoice-barcode">
                        @* Old scanner payload: *S-@Model.Invoice.SalesId* *@
                        *@Model.Invoice.SalesNumber*
                    </div>
                </div>
                <table class="route-info-table">
                    <colgroup>
                        <col style="width: 40%;">
                        <col style="width: 60%;">
                    </colgroup>
                    <tr>
                        <td class="route-info-label">Route</td>
                        <td class="route-info">
                            @if (Model.Invoice.IsLoadSeparate)
                            {
                                <strong class="load-separate">@Model.Invoice.ShipRoute - @Model.Invoice.RouteOrder</strong>
                            }
                            else
                            {
                                <strong>@Model.Invoice.ShipRoute - @Model.Invoice.RouteOrder</strong>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="route-info-label">Sales Rep</td>
                        <td class="route-info">@Model.Invoice.SalesRepName</td>
                    </tr>
                    <tr>
                        <td class="route-info-label">@routeInfoTruckLabel</td>
                        @if (string.IsNullOrWhiteSpace(routeInfoTruckValue))
                        {
                            <td class="route-info">&nbsp;</td>
                        }
                        else
                        {
                            <td class="route-info">@routeInfoTruckValue</td>
                        }
                    </tr>
                    <tr>
                        <td class="route-info-label">@routeInfoDriverLabel</td>
                        @if (string.IsNullOrWhiteSpace(routeInfoDriverValue))
                        {
                            <td class="route-info">&nbsp;</td>
                        }
                        else
                        {
                            <td class="route-info">@routeInfoDriverValue</td>
                        }
                    </tr>
                </table>
            </div>

            <div class="ship-to-grid">
                <div class="ship-to-label highlight-dark">Ship To</div>
                <div class="cust-name">
                    @Model.Invoice.ShipName
                </div>
                <div class="cust-address">
                    @Model.Invoice.ShipAddress<br />
                    @Model.Invoice.ShipCity @Model.Invoice.ShipState @Model.Invoice.ShipZipCode<br />
                    @Model.Invoice.ShipPhone1
                </div>
            </div>
            <div class="instruction-grid">
                <div class="instruction-label highlight-dark">Instruction</div>
                <div class="instruction">@Model.Invoice.Instruction</div>
            </div>
        </div>

    </div>
</div>
