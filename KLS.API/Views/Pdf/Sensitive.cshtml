@using KLS.Models.Reports
@model List<RptSensitiveItem>

<style>
    .pack-grp-header {
        font-size: 12px;
        border-radius: 6px;
        margin-top: 10px;
        padding: 8px;
        background: black;
        color: white;
        border-width: 1px;
        border-color: black;
        border-style: solid;
        margin-bottom: 0px;
        font-family: "Franklin Gothic";
        font-weight: bold;
        text-align: center;
        font-style: italic;
    }

    .small-item-div {
        height: 12px;
        font-size: 10px;
        padding: 0 10px;
        page-break-inside: avoid;
        font-weight: 400;
        text-align: right;
        padding-right: 15%;
    }

    .div-item {
        border: 1px solid grey;
        padding-left: 5px;
        page-break-inside: avoid;
    }

    .itemqty {
        width: 55%;
        float: left;
        text-align: right;
        font-size: 20px;
        font-style: italic
    }

    .itemunit {
        width: 45%;
        float: right;
        font-size: 16px;
    }

    #mc4a {
        -webkit-column-count: 4; /* Chrome, Safari, Opera */
        -moz-column-count: 4;
        -moz-column-gap: 10px;
        column-count: 4;
        column-fill: auto;
        column-gap: 10px;
        font-family: "Segoe UI";
        font-size: 12px;
    }

    .single-row {
        font-family: "Calibri";
        font-size: 11px;
    }

        .single-row::after {
            content: "";
            clear: both;
            display: block;
        }

    strong {
        font-weight: bold;
    }

    .rpt-name {
        font-family: "Franklin Gothic";
        font-weight: bold;
        text-align: center;
        margin-top: 0px;
        font-size: 24px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
    }

    .route {
        font-size: 22px;
    }
</style>

<div class="div-main">
    @if (Model.Count > 0)
    {
        var grpItems = Model.GroupBy(c => c.ItemName).ToList();

        <div class="rpt-name">
            <span class="shipdate">@string.Format("{0:d}", Model.FirstOrDefault()?.ShipDate)</span>
            <span>Freezer ________</span>
            <span>Cooler ________</span>
        </div>

        <div id="mc4a">
            @foreach (var grp in grpItems)
            {
                <h6 class="pack-grp-header">@grp.FirstOrDefault()?.ItemName - @string.Format("{0:0.##}", grp.Sum(c => c.ShipQty))</h6>

                foreach (var item in grp)
                {
                    <div class="div-item">
                        <strong class="route">@item.ShipRoute</strong>
                        <div class="single-row">
                            <div class="itemqty">
                                <strong>@string.Format("{0:0.##}", item.ShipQty)</strong>
                            </div>
                            <div class="itemunit">
                                <span>&nbsp;@item.Unit&nbsp;</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <p class="alert alert-danger">Sensitive item not found.</p>
    }
</div>
