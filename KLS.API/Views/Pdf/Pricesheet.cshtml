@model KLS.Models.EmailPricesheet
@using KLS.Models.Reports
@using System.Globalization
@using System.Linq

@functions {
    private static string Text(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "" : value.Trim();
    }

    private static string Money(decimal? value)
    {
        return string.Format(CultureInfo.CurrentCulture, "{0:c}", value ?? 0m);
    }

    private static string ItemMeta(RptPricesheet item)
    {
        var parts = new[] { Text(item.PackSize), Text(item.Unit) }
            .Where(p => !string.IsNullOrWhiteSpace(p));

        return string.Join(" ", parts);
    }
}

@{
    var items = (Model.Pricesheet ?? Enumerable.Empty<RptPricesheet>()).ToList();
    var ownItems = items.Where(i => !i.IsShared).ToList();
    var sharedItems = items.Where(i => i.IsShared).ToList();
    var company = Model.Company;
    var companyName = Text(company?.CompanyName ?? company?.DisplayName);
    var customerName = Text(Model.PayeeName);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Pricesheet</title>
    <style>
        @@page {
            size: letter;
            margin: 0.35in;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            color: #111;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            line-height: 1.18;
        }

        .header {
            border-bottom: 2px solid #111;
            margin-bottom: 10px;
            padding-bottom: 7px;
        }

        .company {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 2px;
        }

        .company-line {
            margin: 0;
            font-size: 10px;
        }

        .title {
            font-size: 18px;
            font-weight: 700;
            margin: 10px 0 2px;
            text-align: center;
        }

        .subtitle {
            margin: 0;
            text-align: center;
            font-size: 10px;
        }

        .section-title {
            width: 100%;
            margin: 12px 0 5px;
            border: 1px solid #111;
            background: #efefef;
            padding: 3px 6px;
            font-size: 12px;
            font-weight: 700;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px 7px;
            page-break-inside: auto;
        }

        .item {
            min-height: 34px;
            border: 1px solid #777;
            padding: 4px 5px;
            page-break-inside: avoid;
        }

        .item-name {
            min-height: 14px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .item-bottom {
            display: flex;
            justify-content: space-between;
            gap: 6px;
            margin-top: 3px;
            font-size: 10px;
        }

        .item-meta {
            color: #333;
            overflow-wrap: anywhere;
        }

        .price {
            white-space: nowrap;
            text-align: right;
            font-weight: 700;
        }

        .empty {
            border: 1px solid #999;
            padding: 8px;
            color: #555;
            font-style: italic;
        }

        .footer {
            clear: both;
            margin-top: 12px;
            border-top: 1px solid #777;
            padding-top: 5px;
            font-size: 9px;
            text-align: right;
        }
    </style>
</head>
<body>
    <header class="header">
        @if (!string.IsNullOrWhiteSpace(companyName))
        {
            <p class="company">@companyName</p>
        }
        @if (company != null)
        {
            var address = string.Join(", ", new[] { Text(company.AddressLine1), Text(company.City), Text(company.State), Text(company.ZipCode) }.Where(p => !string.IsNullOrWhiteSpace(p)));
            if (!string.IsNullOrWhiteSpace(address))
            {
                <p class="company-line">@address</p>
            }
            if (!string.IsNullOrWhiteSpace(company.Phone))
            {
                <p class="company-line">@company.Phone</p>
            }
        }

        <h1 class="title">
            Pricesheet@if (!string.IsNullOrWhiteSpace(customerName)) { <text> - @customerName</text> }
        </h1>
        <p class="subtitle">@DateTime.Today.ToString("M/d/yyyy", CultureInfo.InvariantCulture)</p>
    </header>

    <section>
        <div class="section-title">Personalized Item List</div>
        @if (ownItems.Any())
        {
            <div class="grid">
                @foreach (var item in ownItems)
                {
                    <div class="item">
                        <div class="item-name">@Text(item.ItemName)</div>
                        <div class="item-bottom">
                            <span class="item-meta">@ItemMeta(item)</span>
                            <span class="price">@Money(item.Price)</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty">No personalized items found.</div>
        }
    </section>

    <section>
        <div class="section-title">Items you may be interested in</div>
        @if (sharedItems.Any())
        {
            <div class="grid">
                @foreach (var item in sharedItems)
                {
                    <div class="item">
                        <div class="item-name">@Text(item.ItemName)</div>
                        <div class="item-bottom">
                            <span class="item-meta">@ItemMeta(item)</span>
                            <span class="price">@Money(item.Price)</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty">No suggested items found.</div>
        }
    </section>

    <footer class="footer">
        Total Items: @items.Count
    </footer>
</body>
</html>
