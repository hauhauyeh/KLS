@model KLS.Models.ForgotPassword
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password</title>
    <partial name="_EmailTheme" />
    <style>
        .page-wrap { max-width: 900px; }
        .title { font-size: 34px; }
        .summary-value { color: #7a1f1f; }
        .footer { text-align: center; font-size: 13px; color: #5d5a6e; }

        .link-box {
            margin-top: 20px;
            padding: 16px;
            border-radius: 14px;
            background: #f7f5ff;
            border: 1px dashed #d6cef0;
        }

        .link-text {
            font-size: 13px;
            color: #5b527a;
            word-break: break-all;
        }
    </style>
</head>

<body>

    <div class="page-wrap">
        <div class="mail-card">

            <div class="top-accent"></div>

            <div class="header">
                <table class="header-table">
                    <tr>

                        <td width="65%">
                            <h1 class="title">Reset Your Password</h1>
                            <p class="subtitle">
                                A request was received to reset the password for your account.
                            </p>
                        </td>

                        <td width="35%">
                            <div class="summary-box">
                                <div class="summary-label">Security Notice</div>
                                <div class="summary-value">Password Reset</div>
                            </div>
                        </td>

                    </tr>
                </table>
            </div>


            <div class="content">
                <div class="greeting-box">
                    <p class="greeting-text">Dear @(Model.Greeting ?? "User"),</p>
                    <p class="greeting-text">
                        We received a request to reset the password associated with your account.
                        Click the button below to create a new password.
                    </p>
                </div>

                <div class="button-wrap">
                    <a href="@Model.ResetUrl" class="action-btn">
                        Reset Your Password
                    </a>
                </div>

                <div class="footer">
                    If you did not request a password reset, please ignore this email.<br>
                    For security reasons this link may expire after some time.
                </div>
            </div>
        </div>
    </div>

</body>
</html>
