@model KLS.Models.ForgotPassword
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px 20px;
            font-family: "Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
            background: radial-gradient(circle at top left,#f8fcef 0%,#edf7df 40%,#e4f0d0 100%);
            color: #24311d;
        }

        .page-wrap {
            max-width: 900px;
            margin: 0 auto;
        }

        .mail-card {
            background: linear-gradient(180deg,#ffffff 0%,#fbfdf8 100%);
            border: 1px solid #dfe9cd;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 18px 44px rgba(48,74,18,.10),0 4px 14px rgba(48,74,18,.06);
        }

        .top-accent {
            height: 8px;
            background: linear-gradient(90deg,#6f9f10 0%,#8fbe22 45%,#c7e57d 100%);
        }

        .header {
            padding: 36px 42px 28px;
            border-bottom: 1px solid #edf3e1;
            background: linear-gradient(135deg,rgba(143,190,34,.10),rgba(255,255,255,0) 45%);
        }

        .logo-section {
            margin-bottom: 20px;
            padding-bottom: 18px;
            border-bottom: 1px solid #e9f0dd;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

            .header-table td {
                vertical-align: top;
            }

        .title {
            margin: 0;
            font-size: 34px;
            font-weight: 800;
            color: #1f2b19;
        }

        .subtitle {
            margin-top: 10px;
            color: #66735c;
            font-size: 15px;
        }

        .status-box {
            padding: 18px 20px;
            border-radius: 18px;
            border: 1px solid #dce8c8;
            background: linear-gradient(180deg,#f8fcef 0%,#eff6e2 100%);
        }

        .status-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            color: #6b785f;
        }

        .status-value {
            font-size: 22px;
            font-weight: 900;
            color: #7a1f1f;
        }

        .content {
            padding: 34px 42px 40px;
        }

        .info-box {
            margin-bottom: 25px;
            padding: 22px;
            border-radius: 18px;
            background: #fcfef8;
            border: 1px solid #e8efdb;
            border-left: 5px solid #8fbe22;
        }

        .info-text {
            margin: 0;
            font-size: 15px;
            line-height: 1.7;
            color: #5f6c56;
        }

        .button-wrap {
            margin: 30px 0;
            text-align: center;
        }

        .reset-btn {
            display: inline-block;
            padding: 14px 32px;
            border-radius: 999px;
            background: linear-gradient(90deg,#6f9f10 0%,#87b91a 100%);
            color: #ffffff !important;
            text-decoration: none;
            font-size: 15px;
            font-weight: 800;
            box-shadow: 0 10px 24px rgba(90,129,22,.22);
        }

        .link-box {
            margin-top: 20px;
            padding: 16px;
            border-radius: 14px;
            background: #f8fbf1;
            border: 1px dashed #d6e3be;
        }

        .link-text {
            font-size: 13px;
            color: #4f5f45;
            word-break: break-all;
        }

        .footer {
            margin-top: 28px;
            padding: 20px;
            border-radius: 18px;
            border: 1px solid #e7efda;
            background: linear-gradient(180deg,#fcfef8 0%,#f6faef 100%);
            text-align: center;
            font-size: 13px;
            color: #5d6a54;
        }
    </style>
</head>

<body>

    <div class="page-wrap">
        <div class="mail-card">

            <div class="top-accent"></div>

            <div class="header">
                <table class="header-table">
                    <tr>

                        <td width="65%">
                            <h1 class="title">Reset Your Password</h1>
                            <p class="subtitle">
                                A request was received to reset the password for your account.
                            </p>
                        </td>

                        <td width="35%">
                            <div class="status-box">
                                <div class="status-label">Security Notice</div>
                                <div class="status-value">Password Reset</div>
                            </div>
                        </td>

                    </tr>
                </table>
            </div>


            <div class="content">
                <div class="info-box">
                    <p class="info-text">
                        We received a request to reset the password associated with your account.
                        Click the button below to create a new password.
                    </p>
                </div>

                <div class="button-wrap">
                    <a href="@Model.ResetUrl" class="reset-btn">
                        Reset Your Password
                    </a>
                </div>

                <div class="footer">
                    If you did not request a password reset, please ignore this email.<br>
                    For security reasons this link may expire after some time.
                </div>
            </div>
        </div>
    </div>

</body>
</html>