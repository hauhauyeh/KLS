@model KLS.Models.SalesDetailDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice Detail</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at top left, #f8fcef 0%, #edf7df 40%, #e4f0d0 100%);
            color: #24311d;
        }

        .page-wrap {
            max-width: 980px;
            margin: 0 auto;
        }

        .mail-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfdf8 100%);
            border: 1px solid #dfe9cd;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 18px 44px rgba(48, 74, 18, 0.10), 0 4px 14px rgba(48, 74, 18, 0.06);
        }

        .top-accent {
            height: 8px;
            background: linear-gradient(90deg, #6f9f10 0%, #8fbe22 45%, #c7e57d 100%);
        }

        .header {
            padding: 36px 42px 28px;
            border-bottom: 1px solid #edf3e1;
            background: linear-gradient(135deg, rgba(143, 190, 34, 0.10), rgba(255,255,255,0) 45%);
        }

        .logo-section {
            margin-bottom: 20px;
            padding-bottom: 18px;
            border-bottom: 1px solid #e9f0dd;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .header-table td {
            vertical-align: top;
            border: none;
            padding: 0;
        }

        .title-block {
            padding-right: 20px;
        }

        .eyebrow {
            display: inline-block;
            margin-bottom: 14px;
            padding: 7px 14px;
            border-radius: 999px;
            background: #eef7da;
            color: #5d8210;
            border: 1px solid #dce8c8;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.15px;
            text-transform: uppercase;
        }

        .title {
            margin: 0;
            font-size: 30px;
            line-height: 1.1;
            font-weight: 800;
            color: #1f2b19;
        }

        .subtitle {
            margin: 10px 0 0;
            color: #66735c;
            font-size: 15px;
            line-height: 1.6;
        }

        .summary-box {
            padding: 20px 24px;
            border-radius: 20px;
            border: 1px solid #dce8c8;
            background: linear-gradient(180deg, #f8fcef 0%, #eff6e2 100%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.75);
        }

        .summary-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6b785f;
            margin-bottom: 8px;
        }

        .summary-value {
            margin: 0;
            font-size: 30px;
            font-weight: 900;
            color: #256328;
            line-height: 1.1;
        }

        .summary-note {
            margin-top: 8px;
            color: #66735c;
            font-size: 13px;
            line-height: 1.5;
        }

        .content {
            padding: 34px 42px 40px;
        }

        .welcome-box {
            margin-bottom: 28px;
            padding: 22px 24px;
            border-radius: 18px;
            background: #fcfef8;
            border: 1px solid #e8efdb;
            border-left: 5px solid #8fbe22;
        }

        .customer {
            margin: 0 0 8px 0;
            font-size: 21px;
            font-weight: 800;
            color: #293521;
        }

        .welcome-text {
            margin: 0;
            color: #5f6c56;
            font-size: 15px;
            line-height: 1.75;
        }

        .alert-box {
            margin-bottom: 24px;
            padding: 16px 18px;
            border-radius: 16px;
            background: linear-gradient(180deg, #fff6f3 0%, #fff1eb 100%);
            border: 1px solid #f1c7b8;
            color: #a23d1d;
            font-size: 14px;
            font-weight: 700;
        }

        .detail-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 28px;
        }

        .detail-table td {
            vertical-align: top;
            border: none;
            padding: 0;
        }

        .detail-card {
            padding: 18px 20px;
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff 0%, #fafdf5 100%);
            border: 1px solid #e5edd7;
            box-shadow: 0 4px 14px rgba(36, 49, 29, 0.04);
        }

        .detail-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6c7a61;
            margin-bottom: 8px;
        }

        .detail-value {
            font-size: 16px;
            font-weight: 700;
            color: #2c3826;
            line-height: 1.5;
            word-break: break-word;
        }

        .table-wrap {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid #e5edd7;
            background: #ffffff;
            box-shadow: 0 6px 18px rgba(36, 49, 29, 0.04);
        }

        .order-lines {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        .order-lines thead th {
            padding: 10px 10px;
            text-align: left;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.4px;
            color: #ffffff;
            background: linear-gradient(90deg, #6f9f10 0%, #87b91a 100%);
            border: none;
        }

        .order-lines tbody td {
            padding: 5px 10px;
            border-bottom: 1px solid #eef3e5;
            font-size: 14px;
            color: #33412c;
            vertical-align: middle;
        }

        .order-lines tbody tr:nth-child(even) td {
            background-color: #fbfdf8;
        }

        .order-lines tbody tr:last-child td {
            border-bottom: none;
        }

        .item-name {
            font-weight: 700;
            color: #2c3925;
        }

        .qty {
            font-weight: 700;
            color: #4f641f;
        }

        .unit-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            background: #f2f7e8;
            border: 1px solid #e0ead0;
            color: #506344;
            font-size: 12px;
            font-weight: 700;
        }

        .money {
            font-weight: 800;
            color: #27341f;
            white-space: nowrap;
        }

        .order-lines tfoot td {
            padding: 5px 10px;
            background: #fafdf5;
            border-top: 1px solid #dce8c8;
        }

        .total-label {
            text-align: right;
            font-size: 16px;
            font-weight: 900;
            color: #34422d;
        }

        .total-value {
            font-size: 18px;
            font-weight: 900;
            color: #256328;
            white-space: nowrap;
        }

        .grand-total {
            color: #7a1f1f;
            font-size: 18px;
        }

        .footer {
            margin-top: 28px;
            padding: 22px 24px;
            border-radius: 18px;
            border: 1px solid #e7efda;
            background: linear-gradient(180deg, #fcfef8 0%, #f6faef 100%);
        }

        .footer p {
            margin: 0 0 10px 0;
            color: #5d6a54;
            font-size: 14px;
            line-height: 1.75;
        }

        .footer p:last-child {
            margin-bottom: 0;
        }

        .signature {
            margin-top: 14px;
            font-weight: 800;
            color: #314028;
        }

        @@media print {
            body {
                padding: 0;
                background: #ffffff;
            }

            .mail-card {
                box-shadow: none;
                border: 1px solid #d9d9d9;
            }
        }

        @@media only screen and (max-width: 768px) {
            .header,
            .content {
                padding: 24px;
            }

            .title {
                font-size: 28px;
            }

            .summary-value {
                font-size: 24px;
            }

            .header-table,
            .header-table tbody,
            .header-table tr,
            .header-table td,
            .detail-table,
            .detail-table tbody,
            .detail-table tr,
            .detail-table td {
                display: block !important;
                width: 100% !important;
            }

            .title-block {
                padding-right: 0;
                padding-bottom: 16px;
            }

            .detail-table td {
                padding-bottom: 12px !important;
            }

            .order-lines thead th,
            .order-lines tbody td,
            .order-lines tfoot td {
                padding: 12px 10px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="mail-card">
            <div class="top-accent"></div>

            <div class="header">
                @* <div class="logo-section">
                    <partial name="_Header.cshtml" model="@Model.CompanyInfo" />
                </div> *@

                <table class="header-table" role="presentation">
                    <tr>
                        <td style="width:65%;">
                            <div class="title-block">
                                <div class="eyebrow">Online Order Confirmation</div>
                                <h1 class="title">Invoice Detail</h1>
                                <p class="subtitle">
                                    A summary of your submitted order and item details.
                                </p>
                            </div>
                        </td>
                        <td style="width:35%;">
                            <div class="summary-box">
                                <div class="summary-label">Order Total</div>
                                <p class="summary-value">@string.Format("{0:c}", Model.Sales.SalesTotal)</p>
                                <div class="summary-note">
                                    Thank you for your order. Please review the details below.
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="content">
                <div class="welcome-box">
                    <p class="customer">Dear @Model.PayeeName,</p>
                    <p class="welcome-text">
                        This is to confirm that we received your online order. Please find the order details and item summary below.
                    </p>
                </div>

                @if (Model.IsPriceZero)
                {
                    <div class="alert-box">
                        Item price will be corrected after system updating price.
                    </div>
                }

                <table class="detail-table" role="presentation">
                    <tr>
                        <td style="width:20%; padding-right:10px;">
                            <div class="detail-card">
                                <div class="detail-label">Order #</div>
                                <div class="detail-value">@Model.Sales.SalesNumber</div>
                            </div>
                        </td>
                        <td style="width:30%; padding-left:5px; padding-right:5px;">
                            <div class="detail-card">
                                <div class="detail-label">Order Date</div>
                                <div class="detail-value">
                                    @(Model.Sales.SalesDate.HasValue? Model.Sales.SalesDate.Value.ToString("F") : "")
                                </div>
                            </div>
                        </td>
                        <td style="width:25%; padding-left:5px; padding-right:5px;">
                            <div class="detail-card">
                                <div class="detail-label">Shipping Date</div>
                                <div class="detail-value">
                                    @(Model.Sales.ShipDate.HasValue? Model.Sales.ShipDate.Value.ToString("D") : "")
                                </div>
                            </div>
                        </td>
                        <td style="width:25%; padding-left:10px;">
                            <div class="detail-card">
                                <div class="detail-label">Ship Route</div>
                                <div class="detail-value">@Model.Sales.ShipRoute</div>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="table-wrap">
                    <table class="order-lines">
                        <thead>
                            <tr>
                                <th width="40%">Item</th>
                                <th width="10%">Qty</th>
                                <th width="15%">Unit</th>
                                <th width="15%" style="text-align:right;">Price</th>
                                <th width="20%" style="text-align:right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SalesDetails != null && Model.SalesDetails.Any())
                            {
                                foreach (var item in Model.SalesDetails)
                                {
                                    <tr>
                                        <td class="item-name">@item.ItemName</td>
                                        <td class="qty">@string.Format("{0:0.##}", item.OrdQty)</td>
                                        <td>
                                            <span class="unit-badge">@item.Unit</span>
                                        </td>
                                        <td class="money" style="text-align:right;">@string.Format("{0:c}", item.UnitPrice)</td>
                                        <td class="money" style="text-align:right;">@string.Format("{0:c}", item.ExtTotal)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="total-label">Subtotal</td>
                                <td class="total-value" style="text-align:right;">
                                    @string.Format("{0:c}", Model.Sales.SubTotal)
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" class="total-label">Tax Total</td>
                                <td class="total-value" style="text-align:right;">
                                    @string.Format("{0:c}", Model.Sales.TaxTotal)
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" class="total-label">Sales Total</td>
                                <td class="total-value grand-total" style="text-align:right;">
                                    @string.Format("{0:c}", Model.Sales.SalesTotal)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @* <partial name="_EmailFooter.cshtml" model="" /> *@

                <div class="footer">
                    <p>
                        If you have any questions or concerns regarding your invoice, please do not hesitate to contact us. We are happy to help.
                    </p>
                    <p>
                        Thank you for choosing our company. We appreciate your business and look forward to serving you again in the future.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>